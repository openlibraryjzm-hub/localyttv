<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Yttv.ViewModels"
             x:Class="Yttv.Components.PlayerControllerPlaylistMenu">

    <Border Style="{StaticResource GlassBorderStyle}" WidthRequest="340" HorizontalOptions="End">
        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
            <!-- Previous Playlist -->
            <Button Text="&lt;" 
                    Command="{Binding Playlist.PreviousPlaylistCommand}" 
                    Style="{StaticResource GlassLabelStyle}" 
                    FontSize="20" 
                    BackgroundColor="Transparent" />
            
            <!-- Page Toggles -->
            <Button Text="🗂️" 
                    Command="{Binding Navigation.SetCurrentPageCommand}" 
                    CommandParameter="playlists"
                    Style="{StaticResource GlassLabelStyle}" 
                    FontSize="20" 
                    BackgroundColor="Transparent" />
            
            <Button Text="🎬" 
                    Command="{Binding Navigation.SetCurrentPageCommand}" 
                    CommandParameter="videos"
                    Style="{StaticResource GlassLabelStyle}" 
                    FontSize="20" 
                    BackgroundColor="Transparent" />

            <!-- Next Playlist -->
            <Button Text="&gt;" 
                    Command="{Binding Playlist.NextPlaylistCommand}" 
                    Style="{StaticResource GlassLabelStyle}" 
                    FontSize="20" 
                    BackgroundColor="Transparent" />

            <!-- Import Toggle -->
            <Button Text="+" 
                    Command="{Binding ToggleImportModalCommand}" 
                    Style="{StaticResource GlassLabelStyle}" 
                    FontSize="24" 
                    BackgroundColor="Transparent" />
            
            <!-- View Mode Toggle -->
            <Button Text="⛶" 
                    Command="{Binding Layout.ToggleViewModeCommand}" 
                    Style="{StaticResource GlassLabelStyle}" 
                    FontSize="20" 
                    BackgroundColor="Transparent" />
        </HorizontalStackLayout>
    </Border>
</ContentView>
