<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Yttv.Models"
             xmlns:vm="clr-namespace:Yttv.ViewModels"
             x:Class="Yttv.Components.PlaylistCard">

    <Border Style="{StaticResource GlassBorderStyle}" Margin="5">
        <Grid RowDefinitions="Auto, *">
            <!-- Header -->
            <Label Grid.Row="0" 
                   Text="{Binding Playlist.Name}" 
                   Style="{StaticResource GlassLabelStyle}" 
                   FontSize="18" 
                   Margin="0,0,0,5" />

            <!-- Thumbnail -->
            <Grid Grid.Row="1" HeightRequest="180">
                <Image Source="{Binding ThumbnailUrl}" 
                       Aspect="AspectFill" />
                
                <!-- Video Count Overlay -->
                <Border VerticalOptions="End" HorizontalOptions="End" Margin="5" Padding="5,2" BackgroundColor="#CC000000" StrokeShape="RoundRectangle 4">
                    <Label Text="{Binding ItemCount, StringFormat='{0} videos'}" TextColor="White" FontSize="12" />
                </Border>
            </Grid>
        </Grid>
        
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=Playlist.SelectPlaylistCommand}" CommandParameter="{Binding .}" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
